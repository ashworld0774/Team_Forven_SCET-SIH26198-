# ==========================================
# BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# (BACKEND SOURCE CODE/.env)
# ==========================================
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aakriti?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@aakriti.com
ADMIN_PASSWORD=AdminSecurePassword123!

# Cloudinary Integration (for doctor documents & image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# ==========================================
# MOBILE APP ENVIRONMENT VARIABLES CONFIGURATION
# (APP SOURCE CODE/.env)
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# ==========================================
# ADMIN PANEL ENVIRONMENT VARIABLES CONFIGURATION
# (ADMIN SOURCE CODE/.env)
# ==========================================
VITE_API_BASE_URL=http://localhost:5000/api
